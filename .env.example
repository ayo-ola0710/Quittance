# 1. AI API Key (Google Gemini)
# Get a free API key at https://aistudio.google.com/
# If omitted, deterministic fallback deliverable is used and receipts display "Output source: fallback"
GEMINI_API_KEY=""

# 2. NEAR Network
NEAR_NETWORK_ID="testnet"
NEAR_NODE_URL="https://rpc.testnet.near.org"

# 3. Manager Account (Signer & Payer)
MANAGER_ACCOUNT_ID="your-account.testnet"
MANAGER_PRIVATE_KEY="ed25519:..."

# 4. Worker Recipient Accounts (Optional overrides for testnet transfers)
WORKER_SCOUT_ACCOUNT_ID="isreel-design.testnet"
WORKER_COPY_ACCOUNT_ID="isreel-copy.testnet"
WORKER_DESIGN_ACCOUNT_ID="isreel-design.testnet"
